#!/usr/bin/env python3
"""Tiny uinput mouse for testing the taskbar. Positions with Hyprland, clicks with uinput.

vmouse.py <x> <y> <script>
  script is a comma list of steps:
    click | rclick | mclick      press+release
    down | up                    left button
    dx:dy                        relative move (e.g. 10:0)
    sleep=<ms>
"""
import fcntl, os, struct, subprocess, sys, time

UI_SET_EVBIT, UI_SET_KEYBIT, UI_SET_RELBIT = 0x40045564, 0x40045565, 0x40045566
UI_DEV_SETUP, UI_DEV_CREATE, UI_DEV_DESTROY = 0x405C5503, 0x5501, 0x5502
EV_SYN, EV_KEY, EV_REL = 0, 1, 2
BTN = {"left": 0x110, "right": 0x111, "middle": 0x112}
REL_X, REL_Y = 0, 1

fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
fcntl.ioctl(fd, UI_SET_EVBIT, EV_KEY)
fcntl.ioctl(fd, UI_SET_EVBIT, EV_REL)
for code in BTN.values():
    fcntl.ioctl(fd, UI_SET_KEYBIT, code)
fcntl.ioctl(fd, UI_SET_RELBIT, REL_X)
fcntl.ioctl(fd, UI_SET_RELBIT, REL_Y)
fcntl.ioctl(fd, UI_DEV_SETUP, struct.pack("HHHH80sI", 0x03, 0x1234, 0x5678, 1, b"claude-test-mouse", 0))
fcntl.ioctl(fd, UI_DEV_CREATE)
time.sleep(0.6)  # let the compositor pick the device up


def emit(etype, code, value):
    now = time.time()
    os.write(fd, struct.pack("llHHi", int(now), int((now % 1) * 1e6), etype, code, value))


def syn():
    emit(EV_SYN, 0, 0)


def button(name, down):
    emit(EV_KEY, BTN[name], 1 if down else 0)
    syn()


try:
    x, y = sys.argv[1], sys.argv[2]
    subprocess.run(["hyprctl", "dispatch", f"hl.dsp.cursor.move({{ x = {x}, y = {y} }})"], capture_output=True)
    # A tiny real motion so the surface under the cursor gets pointer focus.
    emit(EV_REL, REL_X, 1); syn(); time.sleep(0.03)
    emit(EV_REL, REL_X, -1); syn(); time.sleep(0.15)
    for step in sys.argv[3].split(","):
        if step in ("click", "rclick", "mclick"):
            name = {"click": "left", "rclick": "right", "mclick": "middle"}[step]
            button(name, True); time.sleep(0.04); button(name, False)
        elif step == "down":
            button("left", True)
        elif step == "up":
            button("left", False)
        elif step.startswith("sleep="):
            time.sleep(int(step[6:]) / 1000)
        elif step.startswith("goto:"):
            _, gx, gy = step.split(":")
            subprocess.run(["hyprctl", "dispatch", f"hl.dsp.cursor.move({{ x = {gx}, y = {gy} }})"], capture_output=True)
            emit(EV_REL, REL_X, 1); syn(); time.sleep(0.02); emit(EV_REL, REL_X, -1); syn()
        elif ":" in step:
            dx, dy = (int(v) for v in step.split(":"))
            emit(EV_REL, REL_X, dx); emit(EV_REL, REL_Y, dy); syn()
        time.sleep(0.02)
    time.sleep(0.2)
finally:
    fcntl.ioctl(fd, UI_DEV_DESTROY)
    os.close(fd)
