#!/usr/bin/env python3
"""Add or replace a taskbar icon, from its script.

  icon-set <name> <name>.icon.py [--program <prog>]... [--class <regex>]...
  icon-set <name> <draft>.svgbody --what "<what it depicts>" [...]
  icon-set --list          the icon names (built-in and yours)
  icon-set --user ...      your own icons even on the maintainer's PC

It checks the drawing against the spec (refusing errors), installs the script
as <sources>/<name>.icon.py (a bare .svgbody draft becomes a script first),
keeps the drafts and generators next to it whose names start with <name>
(<drafts>/<name>/<date>/), and runs icon-build.

Where (iconkit.source_dir()):
  - yours: ~/.config/omarchy/taskbar-icons-src/, built into
    ~/.config/omarchy/taskbar-icons.json, which desktop updates never touch;
    --program (a terminal program's name) and --class (a window class
    regex) say which windows get it, checked before the built-in rules
  - the maintainer's PC (maintainer=on in ~/.config/omarchy/desktop.conf):
    the desktop repo's icon-src/, built into the built-in set (and the icon
    font) that ships to everyone; map it by hand in bar/modules/
    TaskbarMatch.js (programIcons / classIcons)
Then: omarchy restart shell
Exit status: 0 done, 1 refused (spec errors, bad input), 2 usage.
"""
import datetime
import json
import pathlib
import re
import shutil
import subprocess
import sys

from iconkit import (KIT, USER_JSON, drafts_dir, lint, maintainer, read_body, source_dir, to_script)


def usage():
    print(__doc__)
    sys.exit(2)


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        usage()
    if args == ["--list"]:
        built_in = sorted(p.name.split(".")[0] for p in source_dir(False).glob("*.icon.py")) if maintainer() else []
        if not built_in:
            js = (pathlib.Path.home() / ".config/omarchy/bar/modules/taskbar-icons.js").read_text()
            built_in = [json.loads(m) for m in re.findall(r'^  ("[a-z0-9_-]+"):', js, re.M)]
        print("built-in:", " ".join(built_in))
        own = sorted(p.name.split(".")[0] for p in source_dir(True).glob("*.icon.py"))
        if own:
            print("yours:", " ".join(own))
        return
    user = "--user" in args or not maintainer()
    args = [a for a in args if a != "--user"]
    programs, classes, what, rest = [], [], "", []
    while args:
        a = args.pop(0)
        if a in ("--program", "--class", "--what") and args:
            v = args.pop(0)
            if a == "--program":
                programs.append(v)
            elif a == "--class":
                classes.append(v)
            else:
                what = v
        else:
            rest.append(a)
    if len(rest) != 2:
        usage()
    name, file = rest[0], pathlib.Path(rest[1])
    if not re.fullmatch(r"[a-z0-9_-]+", name):
        sys.exit("icon names are lowercase letters, digits, - or _")
    for c in classes:
        try:
            re.compile(c)
        except re.error as e:
            sys.exit(f"bad class regex {c!r}: {e}")
    if not user and (programs or classes):
        sys.exit("maintainer: map built-in icons in TaskbarMatch.js (programIcons / classIcons), not with flags")

    # The script: as given, or made from a bare drawing.
    if file.suffix == ".py":
        text = file.read_text()
        if not re.match(rf'\s*"""{re.escape(name)}: \S', text):
            sys.exit(f'{file}: an icon script starts with """{name}: <what it depicts>')
    else:
        if not what:
            sys.exit('a bare drawing needs --what "<what it depicts>" (or start from icon-new)')
        text = to_script(name, what.rstrip(".") + ".", read_body(file))
    try:
        body = read_body(file) if file.suffix == ".py" else None
    except RuntimeError as e:
        sys.exit(str(e))
    if body is None:
        tmp = file.parent / f".{name}.check.icon.py"
        tmp.write_text(text)
        try:
            body = read_body(tmp)
        finally:
            tmp.unlink()
    errors = [m for level, m in lint(body) if level == "error"]
    if errors:
        sys.exit("refusing: it breaks the spec:\n  " + "\n  ".join(errors))

    src = source_dir(user)
    src.mkdir(parents=True, exist_ok=True)
    target = src / f"{name}.icon.py"
    action = "replaced" if target.exists() else "added"
    target.write_text(text)

    # The working files: drafts and generators named after the icon.
    dest = drafts_dir(user) / name / datetime.datetime.now().strftime("%Y-%m-%d_%H%M")
    kept = [f for f in sorted(file.resolve().parent.iterdir())
            if f.is_file() and f.name.lower().startswith(name)
            and f.suffix.lower() not in (".png", ".jpg", ".jpeg", ".webp")]
    if kept:
        dest.mkdir(parents=True, exist_ok=True)
        for f in kept:
            shutil.copy2(f, dest / f.name)

    build = [sys.executable, str(KIT / "icon-build")] + (["--user"] if user else [])
    res = subprocess.run(build, capture_output=True, text=True)
    if res.returncode != 0:
        print(res.stdout + res.stderr)
        sys.exit(1)

    if user and (programs or classes):
        data = json.loads(USER_JSON.read_text())
        for p in programs:
            data.setdefault("programs", {})[p] = name
        data["classes"] = [x for x in data.get("classes", []) if x[0] not in classes] + [[c, name] for c in classes]
        tmp = USER_JSON.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(data, indent=2) + "\n")
        tmp.replace(USER_JSON)

    home = str(pathlib.Path.home())
    where = "your icons" if user else "the built-in set"
    maps = ", ".join([f"program {p}" for p in programs] + [f"class /{c}/" for c in classes])
    print(f"{action} '{name}' in {where} ({str(target).replace(home, '~')})"
          + (f", for {maps}" if maps else "") + (f"; kept {len(kept)} working file(s)" if kept else ""))
    print("Then: omarchy restart shell" + ("" if user else " (and map it in TaskbarMatch.js if it's new)"))


main()
