#!/usr/bin/env python3
"""Render icons for review, one row each:
  large | real taskbar size (enlarged, inactive colour) | same, accent colour

  icon-preview <out.png> <file>...

Files: icon scripts (.icon.py / .py) or drafts (.svgbody); an installed
icon's script is <sources>/<name>.icon.py (icon-set --list names them).
Real size is 23px (iconkit.REAL_PX: taskbar.qml draws icons at 55% of a
42px bar); ICON_PX overrides it. Colours come from the current Omarchy theme.
Spec problems are printed below each file's name.
Exit status: 0 written, 1 a file failed, 2 usage.
"""
import os
import pathlib
import re
import subprocess
import sys
import tempfile

from iconkit import REAL_PX, lint, read_body, render


def theme():
    colors = pathlib.Path.home() / ".local/state/omarchy/current/theme/colors.toml"
    found = {}
    try:
        for key, value in re.findall(r'^(\w+)\s*=\s*"(#[0-9a-fA-F]{6})"', colors.read_text(), re.M):
            found.setdefault(key, value)
    except OSError:
        pass
    return found.get("background", "#101315"), found.get("foreground", "#cacccc"), found.get("accent", "#cacccc")


def main():
    args = sys.argv[1:]
    if len(args) < 2 or args[0] in ("-h", "--help"):
        print(__doc__)
        sys.exit(2)
    out, files = args[0], args[1:]
    bg, fg, ac = theme()
    px = int(os.environ.get("ICON_PX", REAL_PX))
    rows = []
    with tempfile.TemporaryDirectory() as tmp:
        tmp = pathlib.Path(tmp)
        for i, f in enumerate(files):
            try:
                body = read_body(f)
            except (OSError, RuntimeError) as e:
                print(f"✗ {f}: {e}")
                sys.exit(1)
            for level, msg in lint(body):
                print(f"{'✗' if level == 'error' else '!'} {pathlib.Path(f).name}: {msg}")
            render(body, tmp / f"{i}-big.png", 96, fg, bg)
            parts = [tmp / f"{i}-big.png"]
            for tag, color in (("fg", fg), ("ac", ac)):
                real = tmp / f"{i}-{tag}.png"
                render(body, real, px, color, bg)
                subprocess.run(["magick", str(real), "-filter", "point", "-resize", "500%", str(real)], check=True)
                parts.append(real)
            row = tmp / f"row-{i}.png"
            subprocess.run(["magick", *map(str, parts), "-background", bg, "-gravity", "center", "+append",
                            "-bordercolor", bg, "-border", "12", str(row)], check=True)
            rows.append(str(row))
        subprocess.run(["magick", *rows, "-append", out], check=True)
    print(f"wrote {out} ({len(rows)} row(s): large | {px}px inactive | {px}px accent)")


main()
