#!/usr/bin/env bash
set -euo pipefail

# Open one throwaway window per window class, screenshot the bar, close them.
#   icon-test <out.png> <class> [<class> ...]
# Ghostty only accepts dotted classes (e.g. chrome-youtube.com__-Default), so
# anything else opens in foot, which takes any app-id.

out="${1:?usage: icon-test <out.png> <class> [<class> ...]}"
shift
(( $# > 0 )) || { echo "usage: icon-test <out.png> <class> [<class> ...]" >&2; exit 2; }

marker="ICONTEST-$$"
cleanup() {
  for a in $(hyprctl clients -j | jq -r --arg m "$marker" '.[] | select(.title | startswith($m)) | .address'); do
    hyprctl dispatch "hl.dsp.window.close({ window = \"address:$a\" })" >/dev/null 2>&1 || true
  done
  sleep 1
  hyprctl clients -j | jq -r --arg m "$marker" '.[] | select(.title | startswith($m)) | .pid' | xargs -r kill 2>/dev/null || true
}
trap cleanup EXIT

i=0
for class in "$@"; do
  i=$((i + 1))
  title="$marker-$i"
  if [[ $class == *.* ]]; then
    setsid ghostty --class="$class" --title="$title" -e sleep 60 >/dev/null 2>&1 &
  else
    setsid foot --app-id="$class" --title="$title" sleep 60 >/dev/null 2>&1 &
  fi
done

for _ in $(seq 1 50); do
  open=$(hyprctl clients -j | jq --arg m "$marker" '[.[] | select(.title | startswith($m))] | length')
  (( open >= $# )) && break
  sleep 0.3
done
sleep 3  # let the taskbar pick up classes and foreground programs

hyprctl clients -j | jq -r --arg m "$marker" '.[] | select(.title | startswith($m)) | "\(.title): \(.class)"'
monitor=$(hyprctl monitors -j | jq -r '.[0] | "\(.x),\(.y) \(.width)x40"')
grim -g "$monitor" "$out"
echo "wrote $out (windows are titled $marker-N; closing them now)"
