#!/usr/bin/env python3
"""Build the taskbar icons from their scripts.

  icon-build            build, check against the spec, install; then run
                        `omarchy restart shell` to see them
  icon-build --check    only check: exit 1 if a script breaks the spec or the
                        installed icons differ from what the scripts draw
  icon-build --user     your own icons (see below) even on the maintainer's PC

Sources (iconkit.source_dir()):
  - maintainer's PC: <desktop repo>/icon-src/icons/<name>.icon.py -> the
    built-in set, bar/modules/taskbar-icons.js (ships to everyone)
  - otherwise: ~/.config/omarchy/taskbar-icons-src/icons/<name>.icon.py ->
    the "icons" of ~/.config/omarchy/taskbar-icons.json (yours; its
    "programs" and "classes" are kept)
Exit status: 0 built / all good, 1 spec errors or out of date, 2 usage.
"""
import json
import sys

from iconkit import (BUILTIN_JS, USER_JSON, lint, maintainer, run_script, source_dir)

HEADER = """.pragma library

// Taskbar icon set: Omarchy-style line icons on a 24px grid. "%C" is the
// draw colour, filled in at runtime so one drawing serves dark and light
// themes and every state (active, inactive, minimized).
//
// GENERATED by the taskbar-icons skill's icon-build from the icon scripts in
// the omarchy-desktop repo (icon-src/icons/<name>.icon.py; the spec is the
// skill's ICON-SPEC.md). Don't edit the entries here: change the script and
// run icon-build.
var icons = {
"""


def build(user):
    src = source_dir(user)
    scripts = sorted(src.glob("*.icon.py"))
    if not scripts:
        sys.exit(f"no icon scripts in {src}")
    bodies, errors = {}, 0
    for script in scripts:
        name = script.name[: -len(".icon.py")]
        try:
            body, _ = run_script(script)
        except RuntimeError as e:
            print(f"✗ {name}: {e}")
            errors += 1
            continue
        for level, msg in lint(body):
            mark = "✗" if level == "error" else "!"
            print(f"{mark} {name}: {msg}")
            errors += level == "error"
        bodies[name] = body
    return src, bodies, errors


def js_text(bodies, current):
    # Everything after the icons object (svg(), halo(), addIcons()) is kept.
    tail = current[current.index("\n}\n") + 1:] if "\n}\n" in current else "}\n"
    entries = ",\n".join(f"  {json.dumps(n)}: {json.dumps(b)}" for n, b in bodies.items())
    return HEADER + entries + "\n" + tail


def main():
    args = sys.argv[1:]
    if any(a not in ("--check", "--user") for a in args):
        print(__doc__)
        sys.exit(2)
    check, user = "--check" in args, "--user" in args or not maintainer()
    src, bodies, errors = build(user)
    if user:
        try:
            data = json.loads(USER_JSON.read_text())
        except (OSError, ValueError):
            data = {}
        new = dict(data, icons=bodies)
        new.setdefault("programs", {})
        new.setdefault("classes", [])
        text, target = json.dumps(new, indent=2) + "\n", USER_JSON
        current = USER_JSON.read_text() if USER_JSON.exists() else ""
    else:
        current = BUILTIN_JS.read_text()
        text, target = js_text(bodies, current), BUILTIN_JS
    if errors:
        print(f"{errors} spec error(s): nothing {'checked' if check else 'installed'}")
        sys.exit(1)
    if check:
        if text != current:
            print(f"{target} is out of date: run icon-build")
            sys.exit(1)
        print(f"{len(bodies)} icons meet the spec and match {target.name}")
        return
    if text == current:
        print(f"{len(bodies)} icons, unchanged ({target})")
        return
    tmp = target.with_suffix(target.suffix + ".tmp")
    tmp.write_text(text)
    tmp.replace(target)
    print(f"built {len(bodies)} icons from {src} into {target}. Then: omarchy restart shell")
    if not user:
        # The icon font (Omarchy's menu) follows the built-in set.
        import subprocess
        from iconkit import KIT
        res = subprocess.run([str(KIT / "icon-font")], capture_output=True, text=True)
        print(res.stdout.strip() or f"icon font NOT rebuilt: {res.stderr.strip()[-300:]}")
        # And each icon's brand colour (the "App colours" setting).
        res = subprocess.run([str(KIT / "icon-colors")], capture_output=True, text=True)
        print((res.stdout.strip().splitlines() or ["icon colours NOT rebuilt"])[-1])


main()
