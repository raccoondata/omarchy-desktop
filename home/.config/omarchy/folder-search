#!/usr/bin/env bash
set -uo pipefail

# zoxide's best folders for some words, for the Super menu's search
# (bar/modules/SuperMenu.qml): up to 3, home itself left out.
#
#   folder-search <word>...        one line each: path <TAB> branch <TAB> kind <TAB> repos
#   folder-search --info[-plain] <path>...
#                                  the same for given folders (pinned ones),
#                                  plus <TAB> changed <TAB> ahead <TAB> behind for
#                                  a repo (files changed, commits ahead of and
#                                  behind its upstream; not with -plain); a folder that's gone:
#                                  just path <TAB> <TAB> <TAB> missing
#
# branch: the git branch if the folder is in a repo ("-" when detached),
# empty if not. kind: the project type from its marker files (in the folder,
# else at its repo's top, else, in a repo, the most common among the folders
# just inside it: code one level down): python, rust, go, typescript,
# node, deno, ruby, php, java, dotnet, elixir, dart, cpp, nix, docker; empty
# if none. repos:
# how many git repos sit directly inside it (a folder of projects), 0 if none.

kind_of() {
  local d=$1
  if [[ -f $d/pyproject.toml || -f $d/setup.py || -f $d/requirements.txt || -f $d/Pipfile ]]; then echo python
  elif [[ -f $d/Cargo.toml ]]; then echo rust
  elif [[ -f $d/go.mod ]]; then echo go
  elif [[ -f $d/tsconfig.json ]]; then echo typescript
  elif [[ -f $d/package.json ]]; then echo node
  elif [[ -f $d/deno.json || -f $d/deno.jsonc ]]; then echo deno
  elif [[ -f $d/Gemfile ]]; then echo ruby
  elif [[ -f $d/composer.json ]]; then echo php
  elif [[ -f $d/pom.xml || -f $d/build.gradle || -f $d/build.gradle.kts ]]; then echo java
  elif compgen -G "$d/*.csproj" >/dev/null || compgen -G "$d/*.sln" >/dev/null; then echo dotnet
  elif [[ -f $d/mix.exs ]]; then echo elixir
  elif [[ -f $d/pubspec.yaml ]]; then echo dart
  elif [[ -f $d/CMakeLists.txt || -f $d/meson.build ]]; then echo cpp
  elif [[ -f $d/flake.nix || -f $d/default.nix ]]; then echo nix
  elif [[ -f $d/Dockerfile || -f $d/compose.yaml || -f $d/docker-compose.yml ]]; then echo docker
  fi
}

# The most common kind among a folder's subfolders (not hidden ones,
# dependencies or build output).
kind_below() {
  local d=$1 sub k best="" n=0
  declare -A count=()
  for sub in "$d"/*/; do
    case ${sub%/} in */node_modules|*/vendor|*/dist|*/build|*/target|*/.*|*/__pycache__|*/venv|*/.venv) continue ;; esac
    k=$(kind_of "${sub%/}")
    [[ -n $k ]] && count[$k]=$(( ${count[$k]:-0} + 1 ))
  done
  for k in "${!count[@]}"; do (( count[$k] > n )) && { n=${count[$k]}; best=$k; }; done
  printf '%s' "$best"
}

describe() {
  local p=$1 status=${2:-} branch="" kind="" top repos=0 g changed="" ahead="" behind="" line
  if top=$(git -C "$p" rev-parse --show-toplevel 2>/dev/null); then
    branch=$(git -C "$p" branch --show-current 2>/dev/null)
    branch=${branch:--}
    kind=$(kind_of "$p")
    [[ -z $kind && $top != "$p" ]] && kind=$(kind_of "$top")
    # A repo whose code is a level down (docs at the top, the app inside).
    [[ -z $kind ]] && kind=$(kind_below "$p")
  else
    kind=$(kind_of "$p")
  fi
  for g in "$p"/*/.git; do [[ -e $g ]] && repos=$((repos + 1)); done
  # A pinned repo's state: one `git status` (untracked files in normal mode).
  if [[ -n $status && -n $branch ]]; then
    changed=0 ahead=0 behind=0
    while IFS= read -r line; do
      case $line in
        "# branch.ab "*) line=${line#\# branch.ab +}; ahead=${line%% *}; behind=${line##*-} ;;
        "#"*) ;;
        *) changed=$((changed + 1)) ;;
      esac
    done < <(timeout 3 git -C "$p" status --porcelain=v2 --branch 2>/dev/null)
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$p" "$branch" "$kind" "$repos" "$changed" "$ahead" "$behind"
}

if [[ ${1:-} == --info || ${1:-} == --info-plain ]]; then
  status=; [[ $1 == --info ]] && status=status
  shift
  for p in "$@"; do
    if [[ -d $p ]]; then describe "$p" $status; else printf '%s\t\t\tmissing\n' "$p"; fi
  done
  exit 0
fi

command -v zoxide >/dev/null || exit 0
zoxide query --list -- "$@" 2>/dev/null | grep -vxF -- "$HOME" | head -n 3 | while IFS= read -r p; do
  describe "$p"
done
