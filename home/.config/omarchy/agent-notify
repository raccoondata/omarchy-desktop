#!/usr/bin/env bash
set -uo pipefail

# Agents saying they're done or need you, from their own hooks:
#   Claude Code  ~/.claude/settings.json hooks Stop and Notification:
#                agent-notify claude      (the hook's JSON on stdin). Grok runs
#                these same hooks (its Claude compatibility), so it lands here
#                too; which agent it really is comes from the session's window.
#   Codex        ~/.codex/config.toml  notify = [".../agent-notify", "codex"]:
#                agent-notify codex <json> (agent-turn-complete)
# One notification per event: the agents' own desktop notifications are off
# where this covers them (Claude: preferredNotifChannel in settings.json; Grok:
# [ui.notifications] in ~/.grok/config.toml). Codex keeps its own for approvals,
# which its notify doesn't report. Agents with no hooks keep theirs.
# When that session's window isn't the one you're looking at, its taskbar icon
# gets the attention dot and a quiet notification says what it said (one per
# session: a newer one replaces it). Clicking it takes you there. "Waiting for
# your input" reminders are skipped (the finish already told you).
#
# Prints nothing and returns at once (the work happens in the background): a
# hook's output goes back to the agent.

kind="${1:-}"
if [[ $kind == claude ]]; then
  input="$(cat)"
else
  input="${2:-}"
fi
start="$PPID"

(
  name="$kind"
  headline="" body=""
  case "$kind" in
    claude)
      # Claude Code (snake_case fields) or Grok (camelCase, plus Claude's
      # hook_event_name).
      name="Claude"
      case "$(jq -r '.hook_event_name // ""' <<<"$input")" in
        Stop)
          event=finished
          body="$(jq -r '.last_assistant_message // .lastAssistantMessage // ""' <<<"$input")"
          transcript="$(jq -r '.transcript_path // .transcriptPath // ""' <<<"$input")"
          if [[ -z $body && -f $transcript ]]; then
            body="$(tac "$transcript" | jq -r 'select(.type == "assistant") | [.message.content[]? | select(.type == "text") | .text] | join(" ")' 2>/dev/null | grep -m1 .)"
          fi ;;
        Notification)
          # Only the ones that need you: a permission prompt or a question.
          # "Idle" reminders and the like are skipped (the finish said it).
          case "$(jq -r '.notification_type // .notificationType // ""' <<<"$input")" in
            permission_prompt|elicitation_dialog|agent_needs_input) ;;
            "") [[ "$(jq -r '.message // ""' <<<"$input")" == *"permission"* ]] || exit 0 ;;
            *) exit 0 ;;
          esac
          event=needs
          body="$(jq -r '.message // ""' <<<"$input")" ;;
        *) exit 0 ;;
      esac ;;
    codex)
      name="Codex"
      case "$(jq -r '.type // ""' <<<"$input")" in
        agent-turn-complete) event=finished; body="$(jq -r '."last-assistant-message" // ""' <<<"$input")" ;;
        approval-requested) event=needs; body="It's asking for approval." ;;
        *) exit 0 ;;
      esac ;;
    *) exit 0 ;;
  esac

  # The session's window: walk up from the agent to a process that owns one.
  clients="$(hyprctl clients -j 2>/dev/null)" || exit 0
  pid="$start" address="" title=""
  for _ in $(seq 1 12); do
    [[ $pid =~ ^[0-9]+$ && $pid -gt 1 ]] || break
    hit="$(jq -r --argjson p "$pid" '.[] | select(.pid == $p) | "\(.address)\t\(.title)"' <<<"$clients" | head -1)"
    if [[ -n $hit ]]; then
      address="${hit%%$'\t'*}"
      title="${hit#*$'\t'}"
      break
    fi
    pid="$(awk '{print $4}' "/proc/$pid/stat" 2>/dev/null)"
  done
  [[ -n $address ]] || exit 0
  # You're looking at it: nothing to say.
  [[ "$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // ""')" == "$address" ]] && exit 0

  # Which agent it really is (Grok comes through Claude's hooks): the session
  # as ./agents sees it.
  real="$("$HOME/.config/omarchy/agents" sessions 2>/dev/null | jq -r --arg a "$address" '.[] | select(.address == $a) | .name' | head -1)"
  [[ -n $real ]] && name="$real"
  [[ $event == needs ]] && headline="$name needs you" || headline="$name finished"

  omarchy-shell -q taskbar attention "$address"
  # One line of what it said, and which session.
  body="$(tr '\n' ' ' <<<"$body" | sed -E 's/[*`#>_]+//g; s/  +/ /g; s/^ //')"
  (( ${#body} > 160 )) && body="${body:0:157}…"
  title="$(sed -E 's/^[^[:alnum:]]+//' <<<"$title")"
  [[ -n $title ]] && body="$title — ${body:-done}"
  omarchy-notification-send -r "$(( 16#${address: -5} + 7000 ))" "$headline" "$body" \
    --exec "$HOME/.config/omarchy/taskbar-action" focus "$address"
) >/dev/null 2>&1 &
disown
exit 0
