#!/usr/bin/env bash
set -euo pipefail

# The system-level (root) parts of the desktop. Run by omarchy-desktop's
# install.sh; safe to run again: it only fills in what's missing or different.
# Asks for your password once.
#
#   packages   what the desktop's scripts use on top of Omarchy: the title-bar
#              plugin (hyprland-plugin-hyprbars, AUR), plus socat, jq,
#              nautilus-python (the Files menu), tensaku (the screenshot
#              editor), cava (the music's spectrum, for the equalizers)
#   Rescue     its system parts (its bin/setup-system): hyprlock and
#              efibootmgr, the rescue console on Ctrl+Alt+Esc (passwordless
#              `chvt`), passwordless `efibootmgr --bootnext` with Windows
#
# Remote access (RustDesk) is separate and optional: ./setup-remote.

bold=$'\e[1m' off=$'\e[0m'

echo "${bold}System setup for the desktop${off}"
sudo -v

# --- packages ---------------------------------------------------------------
pkgs=(hyprland-plugin-hyprbars socat jq nautilus-python tensaku cava
  inotify-tools rsync git make gcc)
mapfile -t missing < <(comm -23 <(printf '%s\n' "${pkgs[@]}" | sort -u) <(pacman -Qq | sort))
if (( ${#missing[@]} )); then
  yay -S --needed --noconfirm "${missing[@]}"
else
  echo "  packages: all installed"
fi

# --- Rescue's ---------------------------------------------------------------
rescue="$HOME/.config/omarchy/plugins/rescue/bin/setup-system"
if [[ -x $rescue ]]; then
  "$rescue"
else
  echo "  no Rescue plugin: its system parts skipped"
fi
echo
echo "${bold}Done.${off}"
[[ -n ${OMARCHY_DESKTOP_INSTALL:-${OMARCHY_CONFIG_INSTALL:-}} ]] || read -r -p "Press Enter to close." _
