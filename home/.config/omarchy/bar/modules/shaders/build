#!/usr/bin/env bash
set -euo pipefail
# Compile the shell's shaders (*.frag here) to Qt's shader packs (*.frag.qsb),
# which ShaderEffect loads. The .qsb files ship with the desktop, so only the
# maintainer needs this (qsb: qt6-shadertools).
#   shaders/build
cd "$(dirname "$0")"
for f in *.frag; do
  /usr/lib/qt6/bin/qsb --glsl "100 es,120,150" --hlsl 50 --msl 12 -o "$f.qsb" "$f"
  echo "built $f.qsb"
done
