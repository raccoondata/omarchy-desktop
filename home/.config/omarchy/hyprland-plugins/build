#!/usr/bin/env bash
set -euo pipefail

# Builds the two local Hyprland plugins into ~/.local/lib/hyprland/:
#   libhyprdragevents.so  reports window drags (windowdragstart/windowdragend
#                         events) so the taskbar can drop windows on workspace
#                         numbers and snap them to screen edges (dragevents/)
#   libhyprbars-fixed.so  the hyprbars title-bar plugin (AUR
#                         hyprland-plugin-hyprbars) plus hyprbars-fixes.patch:
#                         a title-bar drag dropped over the top bar no longer
#                         sticks to the pointer, and a drag still ends if focus
#                         moved on the way
#
# Run after a Hyprland update (plugins must match the running version; until
# then ~/.config/omarchy/titlebars-load falls back to the stock hyprbars and
# drops on workspaces/edges stop working), then log out and back in.
# Needs git, make, g++ and the hyprland headers (from the hyprland package).

here="$(cd "$(dirname "$0")" && pwd)"
lib="$HOME/.local/lib/hyprland"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
mkdir -p "$lib"

# Replace by rename: the running compositor has the old file mapped.
install_so() { install -m755 "$1" "$lib/.$2.new" && mv "$lib/.$2.new" "$lib/$2"; }

echo "== dragevents"
make -C "$here/dragevents" -B dragevents.so
install_so "$here/dragevents/dragevents.so" libhyprdragevents.so

echo "== hyprbars"
git clone -q https://github.com/hyprwm/hyprland-plugins.git "$work/src"
cd "$work/src"
# Build the hyprland-plugins commit made for this Hyprland release. The AUR
# package's PKGBUILD pins it; hyprbars-commit remembers the last one used, per
# Hyprland version, in case yay's cache has been cleaned. Never guess: a
# plugin built from the wrong commit may not even compile.
version="$(pacman -Q hyprland | awk '{print $2}' | cut -d- -f1)"
record="$here/hyprbars-commit"
commit="$(grep -o 'commit=[0-9a-f]*' "$HOME/.cache/yay/hyprland-plugins/PKGBUILD" 2>/dev/null | cut -d= -f2 || true)"
pkgver="$(grep -o "^pkgver='*[0-9.]*" "$HOME/.cache/yay/hyprland-plugins/PKGBUILD" 2>/dev/null | grep -o '[0-9.]*$' || true)"
if [[ -z $commit || $pkgver != "$version" ]]; then
  commit="$(awk -v v="$version" '$1 == v {print $2}' "$record" 2>/dev/null || true)"
fi
if [[ -z $commit ]]; then
  echo "No hyprland-plugins commit known for Hyprland $version." >&2
  echo "Update the AUR package first (yay -S hyprland-plugin-hyprbars), then rerun." >&2
  exit 1
fi
git checkout -q "$commit"
echo "hyprbars from commit $commit (Hyprland $version)"
patch -p0 -d hyprbars < "$here/hyprbars-fixes.patch"
make -C hyprbars all
install_so hyprbars/hyprbars.so libhyprbars-fixed.so
{ grep -v "^$version " "$record" 2>/dev/null || true; echo "$version $commit"; } > "$record.tmp" && mv "$record.tmp" "$record"

echo "Done. Log out and back in to load them."
