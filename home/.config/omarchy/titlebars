#!/usr/bin/env bash
set -uo pipefail

# Title bars (hyprbars) on or off, now and from the next login.
#   titlebars on | off | toggle | status      (status: exit 0 when on)

flag="$HOME/.config/omarchy/titlebars-off"

on() { rm -f "$flag"; "$HOME/.config/omarchy/titlebars-load"; }
off() {
  touch "$flag"
  # Whichever build is loaded (the list doesn't say which file it came from).
  local path
  for path in "$HOME/.local/lib/hyprland/libhyprbars-fixed.so" /usr/lib/libhyprbars.so; do
    hyprctl plugin unload "$path" >/dev/null 2>&1
  done
}

case "${1:-status}" in
  on) on ;;
  off) off ;;
  toggle) if [[ -e $flag ]]; then on; else off; fi ;;
  status) [[ ! -e $flag ]] ;;
  *) echo "usage: titlebars on|off|toggle|status" >&2; exit 2 ;;
esac
