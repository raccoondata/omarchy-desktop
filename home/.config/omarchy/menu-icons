#!/usr/bin/env bash
set -euo pipefail

# Omarchy's menu (Super+Alt+Space) with the desktop's icons on the entries
# that are apps: the agents, browsers, terminals and editors under Setup >
# Default, Install / Remove, and a few others (menu-icons.json maps entry ->
# icon). The icons come from the desktop's icon font
# (~/.local/share/fonts/omarchy-desktop-icons.otf, codepoints in
# icon-codepoints.json); the entries are overridden in your menu extension
# file, extensions/omarchy-menu.jsonc, in one marked block this writes and
# removes. Omarchy's other entries keep their own glyphs.
#   menu-icons on | off | status
# Taskbar & Desktop > Icons > Omarchy menu runs it.

dir="$HOME/.config/omarchy"
menu="$dir/extensions/omarchy-menu.jsonc"
map="$dir/menu-icons.json"
cps="$dir/icon-codepoints.json"
begin="  // >>> omarchy-desktop icons (Taskbar & Desktop > Icons; generated by ~/.config/omarchy/menu-icons, don't edit)"
end="  // <<< omarchy-desktop icons"

strip() {  # the file without our block
  python3 - "$menu" "$begin" "$end" <<'PY'
import sys
p, b, e = sys.argv[1:]
lines = open(p).read().split("\n")
out, skip = [], False
for l in lines:
    if l == b:
        skip = True
        continue
    if skip and l == e:
        skip = False
        continue
    if not skip:
        out.append(l)
open(p, "w").write("\n".join(out))
PY
}

case "${1:-status}" in
  status)
    grep -qF "$begin" "$menu" 2>/dev/null && echo on || echo off
    ;;
  off)
    [[ -f $menu ]] && strip
    echo off
    ;;
  on)
    [[ -f $menu ]] || { mkdir -p "$(dirname "$menu")"; cp /usr/share/omarchy/config/omarchy/extensions/omarchy-menu.jsonc "$menu"; }
    [[ -f $cps ]] || { echo "no icon font codepoints ($cps)" >&2; exit 1; }
    strip
    python3 - "$menu" "$map" "$cps" "$begin" "$end" <<'PY'
import json, re, sys
p, mapf, cpf, b, e = sys.argv[1:]
text = open(p).read()
mapping, cps = json.load(open(mapf)), json.load(open(cpf))
# Entries your file already defines stay yours (a second definition would
# replace the first).
mine = set(re.findall(r'^\s*"([a-z0-9._-]+)"\s*:', text, re.M))
rows = [f'  {json.dumps(k)}: {{"icon": "{chr(int(cps[v], 16))}", "iconFont": "omarchy-desktop-icons"}},'
        for k, v in mapping.items() if k not in mine and v in cps]
i = text.rstrip().rfind("}")
head = text[:i].rstrip()
if not head.endswith((",", "{")):
    head += ","
open(p, "w").write(head + "\n\n" + b + "\n" + "\n".join(rows) + "\n" + e + "\n" + text[i:])
print(f"on ({len(rows)} entries)")
PY
    ;;
  *) sed -n '3,14p' "$0"; exit 2 ;;
esac
