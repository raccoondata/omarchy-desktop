#!/usr/bin/env bash
set -euo pipefail

# Super+Down: one step down the ladder  maximized -> tiled -> minimized.

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy"
state_file="$state_dir/minimized-windows.json"
anchor_file="$state_dir/restore-anchor"
mkdir -p "$state_dir"
[[ -f "$state_file" ]] || printf '[]\n' > "$state_file"

window="$(hyprctl activewindow -j)"
address="$(jq -r '.address // empty' <<<"$window")"
workspace="$(jq -r '.workspace.id // empty' <<<"$window")"
fullscreen="$(jq -r '.fullscreen // 0' <<<"$window")"

[[ -n "$address" && -n "$workspace" ]] || exit 0
[[ "$workspace" != -* ]] || exit 0

# A maximized window returns to its normal tile first.
if (( fullscreen > 0 )); then
  : > "$anchor_file"
  hyprctl dispatch 'hl.dsp.window.fullscreen({ mode = "maximized" })'
  exit 0
fi

temporary_file="$(mktemp "$state_dir/minimized-windows.XXXXXX")"
jq --arg address "$address" --argjson workspace "$workspace" --argjson saved_at "$(date +%s%N)" \
  '[.[] | select(.address != $address)] + [{address: $address, workspace: $workspace, savedAt: $saved_at}]' \
  "$state_file" > "$temporary_file"
mv "$temporary_file" "$state_file"

hyprctl dispatch 'hl.dsp.window.move({ workspace = "special:scratchpad", follow = false })' >/dev/null

# Remember where focus landed, so an immediate Super+Up undoes this minimize
# instead of maximizing the neighbour that just received focus.
sleep 0.05
hyprctl activewindow -j | jq -r '.address // empty' > "$anchor_file"
