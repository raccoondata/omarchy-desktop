#!/usr/bin/env bash
set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy"
state_file="$state_dir/minimized-windows.json"
anchor_file="$state_dir/restore-anchor"
mkdir -p "$state_dir"
[[ -f "$state_file" ]] || printf '[]\n' > "$state_file"

# Save every ordinary mapped window on the active workspace before moving them
# to the hidden scratchpad. Each entry retains its workspace for restore.
# savedAt follows focus history, so repeated Super+Up brings back the most
# recently focused window first, then the one before it, and so on.
workspace="$(hyprctl activeworkspace -j | jq -r '.id')"
(( workspace >= 0 )) || exit 0

windows="$(hyprctl clients -j | jq --argjson base "$(date +%s%N)" --argjson ws "$workspace" '
  [.[] | select(.mapped and .workspace.id == $ws)]
  | sort_by(.focusHistoryID) | reverse | to_entries
  | map({address: .value.address, workspace: .value.workspace.id, savedAt: ($base + .key)})')"
[[ "$(jq 'length' <<<"$windows")" != "0" ]] || exit 0

temporary_file="$(mktemp "$state_dir/minimized-windows.XXXXXX")"
jq --argjson windows "$windows" \
  'reduce $windows[] as $window (.;
    [.[] | select(.address != $window.address)] + [$window])' \
  "$state_file" > "$temporary_file"
mv "$temporary_file" "$state_file"

while IFS= read -r address; do
  hyprctl dispatch "hl.dsp.window.move({ workspace = \"special:scratchpad\", follow = false, window = \"address:$address\" })" >/dev/null
done < <(jq -r '.[].address' <<<"$windows")

: > "$anchor_file"
