#!/usr/bin/env bash
set -uo pipefail

# When Hyprland crashes, start-hyprland restarts it in "safe mode": your config
# (and so all of Omarchy: bar, keybindings, launchers) isn't loaded. This
# watches for that and opens your two coding agents (~/.config/omarchy/agents
# primary) in the safe-mode session,
# each already asked to find out why it crashed.
#
# Runs as the systemd user service hyprland-safe-mode-agents (see
# ~/.config/systemd/user/). It sleeps on inotify until a Hyprland instance
# starts, so it costs nothing in between.
#
#   safe-mode-agents            watch (the service)
#   safe-mode-agents --launch <instance-signature>   open the agents now

log="$HOME/.local/state/omarchy/safe-mode-agents.log"
mkdir -p "${log%/*}"
# Keep the log small: past 256 KB, keep its last 500 lines.
if [[ -f $log ]] && (( $(stat -c %s "$log") > 262144 )); then
  tail -n 500 "$log" > "$log.tmp" && mv "$log.tmp" "$log"
fi
runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr"

prompt="Hyprland just crashed and restarted in safe mode, so my config and Omarchy's shell aren't loaded. Find out why it crashed: the newest report in ~/.cache/hyprland/ (hyprlandCrashReport*.txt), coredumpctl, and the journal for this boot. My desktop config has a git history (~/.config/omarchy/config-history log / diff): recent changes are the first suspect. Explain the cause and the fix. Only investigate: don't reload or restart Hyprland, load or unload plugins, or change config without asking me first."

launch() {
  local signature="$1" socket
  socket="$(hyprctl instances -j 2>/dev/null | jq -r --arg s "$signature" '.[] | select(.instance == $s) | .wl_socket')"
  [[ -n "$socket" ]] || { echo "no wayland socket for $signature"; return 1; }
  echo "$(date '+%F %T') opening agents in $signature ($socket)"
  cd "$HOME/Work" 2>/dev/null || cd "$HOME"
  # Straight into the safe-mode compositor: its socket and signature, no uwsm.
  export WAYLAND_DISPLAY="$socket" HYPRLAND_INSTANCE_SIGNATURE="$signature"
  local agents="$HOME/.config/omarchy/agents" id p cmd
  for id in $("$agents" primary | tr ',' ' '); do
    p="$prompt"
    # Claude Code with a diagnose-crash skill installed: start with it.
    [[ $id == claude && -d $HOME/.claude/skills/diagnose-crash ]] && p="Use the diagnose-crash skill. $prompt"
    mapfile -t cmd < <("$agents" command "$id" --prompt "$p")
    (( ${#cmd[@]} )) || continue
    setsid -f ghostty --class="org.omarchy.${id//-/_}" --title="$id (crash)" -e "${cmd[@]}" >/dev/null 2>&1
  done
}

# The Hyprland instance behind a signature runs with --safe-mode.
is_safe_mode() {
  local pid
  pid="$(hyprctl instances -j 2>/dev/null | jq -r --arg s "$1" '.[] | select(.instance == $s) | .pid')"
  [[ -n "$pid" && -r /proc/$pid/cmdline ]] && tr '\0' '\n' < "/proc/$pid/cmdline" | grep -qx -- --safe-mode
}

if [[ "${1:-}" == --launch ]]; then
  launch "${2:?usage: safe-mode-agents --launch <instance-signature>}" >>"$log" 2>&1
  exit
fi

exec >>"$log" 2>&1
mkdir -p "$runtime"
echo "$(date '+%F %T') watching $runtime"
inotifywait -q -m -e create -e moved_to --format '%f' "$runtime" | while read -r signature; do
  # Give the new compositor a moment to answer on its socket.
  for _ in {1..40}; do
    hyprctl instances -j 2>/dev/null | jq -e --arg s "$signature" 'any(.instance == $s)' >/dev/null && break
    sleep 0.25
  done
  if is_safe_mode "$signature"; then
    sleep 2
    launch "$signature"
  fi
done
