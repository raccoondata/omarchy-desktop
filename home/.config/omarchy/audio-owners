#!/usr/bin/env bash
set -uo pipefail

# Which window owns each audio stream (for the taskbar's speaker mark):
#   audio-owners <pid>...   ->   {"<pid>": "0x<window address>", ...}
# A stream's process is often a helper under the window's process (Chromium's
# audio service, a player started from a terminal), so walk up the parents.

declare -A window_of
while read -r pid address; do
  window_of[$pid]="$address"
done < <(hyprctl clients -j 2>/dev/null | jq -r '.[] | "\(.pid) \(.address)"')

first=true
printf '{'
for pid in "$@"; do
  [[ $pid =~ ^[0-9]+$ ]] || continue
  p="$pid"
  for _ in {1..16}; do
    if [[ -n ${window_of[$p]:-} ]]; then
      $first || printf ','
      first=false
      printf '"%s":"%s"' "$pid" "${window_of[$p]}"
      break
    fi
    p="$(awk '{print $4}' "/proc/$p/stat" 2>/dev/null)"
    [[ -n $p && $p != 0 && $p != 1 ]] || break
  done
done
printf '}\n'
