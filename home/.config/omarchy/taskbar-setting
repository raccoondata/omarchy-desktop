#!/usr/bin/env bash
set -euo pipefail

# The taskbar's options, in ~/.config/omarchy/taskbar-settings.json, which the
# taskbar watches and applies live. (They used to sit on its entry in
# shell.json, but any change there makes Omarchy rebuild the widget, which
# closed the settings window with every toggle.) Used by the settings window
# (bar/modules/TaskbarSettings.qml) and the Setup menu.
#
#   taskbar-setting get <key> [default]
#   taskbar-setting set <key> <true|false|number|string> [<key> <value>]...
#                                             several at once, in one write
#   taskbar-setting toggle <key> <default>
#   taskbar-setting on <key> <default>        exit 0 if it's true

file="$HOME/.config/omarchy/taskbar-settings.json"
shell="$HOME/.config/omarchy/shell.json"

# First run: take the options over from the taskbar's shell.json entry.
if [[ ! -s $file ]]; then
  jq '[.bar.layout[][] | select(.id == "taskbar")] | first // {}
      | del(.id, .source, .type)
      | with_entries(.value |= (if . == "true" then true elif . == "false" then false else . end))' \
    "$shell" > "$file.tmp" 2>/dev/null || echo '{}' > "$file.tmp"
  mv "$file.tmp" "$file"
fi

get() {
  jq -r --arg k "$1" --arg d "${2:-}" 'if has($k) and .[$k] != null then .[$k] | tostring else $d end' "$file"
}

# Writes take a lock: two at once (quick clicks, or one choice that sets two
# keys) would each read the old file and the second would undo the first.
exec 9>"$file.lock"
set_value() {  # set_value <key> <value> [<key> <value>]...
  local tmp args=() filter="."
  flock 9
  tmp="$(mktemp "$file.XXXXXX")"
  # Numbers and true/false stay JSON; anything else is a string. (Not
  # `fromjson? // $v`: `//` would turn a real false back into "false".)
  local i=0
  while (( $# >= 2 )); do
    args+=(--arg "k$i" "$1" --arg "v$i" "$2")
    filter="$filter | .[\$k$i] = (try (\$v$i | fromjson) catch \$v$i)"
    shift 2
    i=$((i + 1))
  done
  jq "${args[@]}" "$filter" "$file" > "$tmp"
  mv "$tmp" "$file"
  flock -u 9
}

case "${1:-}" in
  get) get "${2:?key}" "${3:-}" ;;
  set)
    shift
    (( $# >= 2 && $# % 2 == 0 )) || { echo "usage: taskbar-setting set <key> <value> [<key> <value>]..." >&2; exit 2; }
    set_value "$@"
    ;;
  toggle)
    if [[ "$(get "${2:?key}" "${3:-false}")" == true ]]; then set_value "$2" false; else set_value "$2" true; fi
    ;;
  on) [[ "$(get "${2:?key}" "${3:-false}")" == true ]] ;;
  *) sed -n '3,14p' "$0"; exit 2 ;;
esac
