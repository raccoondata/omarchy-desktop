#!/usr/bin/env bash
set -euo pipefail

# The audio outputs, named the way people say them, for the now-playing card's
# output switcher (bar/modules/nowplaying.qml).
#
#   audio-outputs                 JSON: [{key, sink, id, port, label, kind, current}]
#   audio-outputs set <sink> [port]
#
# One entry per usable output: a sink, or each available port of it when it
# has several (plugging headphones into a PC's jack switches the port, not
# the sink). Names: Speakers, Headphones, the monitor's name over HDMI /
# DisplayPort, the device's name over Bluetooth or USB. kind: speakers,
# headphones, display, bluetooth, usb. current: where the sound goes now
# (through any speaker tuning: omarchy-audio-output-sink). Virtual sinks
# (tuning filters, EasyEffects) aren't listed; they front a real one.

if [[ ${1:-} == set ]]; then
  sink="${2:?sink}" port="${3:-}"
  id="$(pactl -f json list sinks | jq -r --arg s "$sink" '.[] | select(.name == $s) | .properties["object.id"] // .index')"
  [[ -n $id ]] || { echo "no such sink: $sink" >&2; exit 1; }
  omarchy-audio-output-set-default "$id" "$sink"
  [[ -z $port ]] || pactl set-sink-port "$sink" "$port"
  exit 0
fi

current="$(omarchy-audio-output-sink 2>/dev/null || pactl get-default-sink)"
pactl -f json list sinks | jq -c --arg current "$current" '
  def tidy: sub(" (Analog|Digital) Stereo.*$"; "") | sub(" Stereo$"; "");
  def portkind($p):
    ($p.name | ascii_downcase) as $n
    | if ($n | test("hdmi|displayport|-dp")) then "display"
      elif ($n | test("headphone|headset")) then "headphones"
      else "speakers" end;
  [ .[]
    | select(.name | test("^(alsa_output|bluez_output)\\."))
    | . as $s
    | ($s.properties["device.bus"] // "") as $bus
    | ($s.properties["node.nick"] // "") as $nick
    | ([$s.ports[] | select(.availability != "not available")]) as $ports
    | (if ($ports | length) > 1 then $ports
       else [($s.ports[] | select(.name == $s.active_port)) // {name: "", description: ""}] end)[]
    | . as $p
    | (if $bus == "bluetooth" or ($s.name | startswith("bluez_output.")) then
         {kind: (if (($s.properties["device.form_factor"] // "") | test("head")) then "headphones" else "bluetooth" end),
          label: ($s.description | tidy)}
       elif $bus == "usb" then
         {kind: (if portkind($p) == "headphones" then "headphones" else "usb" end), label: ($s.description | tidy)}
       elif portkind($p) == "display" then
         {kind: "display", label: (if $nick != "" and ($nick | test("HDA|HDMI|Analog") | not) then $nick else "Monitor" end)}
       elif portkind($p) == "headphones" then {kind: "headphones", label: "Headphones"}
       else {kind: "speakers", label: "Speakers"} end) as $n
    | {key: ($s.name + "#" + $p.name), sink: $s.name, id: ($s.properties["object.id"] // ($s.index | tostring)),
       port: $p.name, label: $n.label, kind: $n.kind,
       current: ($s.name == $current and ($p.name == "" or $p.name == $s.active_port))}
  ]
  # Same name twice (two jacks, two monitors): add the port to tell them apart.
  | group_by(.label) | map(if length > 1 then map(.label += " (" + (.port | sub("^[a-z]+-output-"; "")) + ")") else . end) | flatten
  | sort_by(.kind != "speakers", .kind != "headphones", .label)
'
