#!/usr/bin/env bash
set -euo pipefail

# Window-drop handler. The taskbar runs it with --no-taskbar when a window drag
# (any kind, reported by the dragevents plugin) ends off its workspace numbers.
# Run by hand without the flag, it first asks the taskbar whether the cursor is
# on a workspace number.
#
# A drop on a workspace number in the taskbar moves the window there. A drop
# near a monitor's top edge maximizes the window (the same maximize as
# Super+Up). A drop near the left or right edge promotes the focused tiled
# window to that half of the workspace's root split, and the remaining window
# tree is kept together on the opposite half.
edge_px=48

ask_taskbar=true
[[ "${1:-}" == "--no-taskbar" ]] && ask_taskbar=false

sleep 0.08

window="$(hyprctl activewindow -j)"
cursor="$(hyprctl cursorpos -j)"
cursor_x="$(jq -r '.x | floor' <<<"$cursor")"
cursor_y="$(jq -r '.y | floor' <<<"$cursor")"

if $ask_taskbar; then
  workspace="$(omarchy-shell taskbar workspaceAtPoint "$cursor_x" "$cursor_y" 2>/dev/null || true)"
  if [[ "$workspace" =~ ^[0-9]+$ ]] && (( workspace > 0 )); then
    exec "$HOME/.config/omarchy/taskbar-action" move "$workspace" "$(jq -r .address <<<"$window")"
  fi
fi

[[ "$(jq -r '.floating // false' <<<"$window")" == "false" ]] || exit 0
[[ "$(jq -r '.fullscreen // 0' <<<"$window")" == "0" ]] || exit 0

# Layout coordinates are logical: a monitor spans width/scale of them.
monitor="$(hyprctl monitors -j | jq -c \
  --argjson x "$cursor_x" --argjson y "$cursor_y" \
  '.[] | (.width / .scale | floor) as $w | (.height / .scale | floor) as $h
   | select($x >= .x and $x < (.x + $w) and $y >= .y and $y < (.y + $h))' \
  | head -n1)"
[[ -n "$monitor" ]] || exit 0

monitor_x="$(jq -r '.x' <<<"$monitor")"
monitor_y="$(jq -r '.y' <<<"$monitor")"
monitor_width="$(jq -r '(.width / .scale) | floor' <<<"$monitor")"
right_edge=$((monitor_x + monitor_width))

# Top edge (corners included): maximize. Clear the Super+Up restore anchor as
# window-maximize-or-restore does, so the next Super+Up toggles this maximize.
if (( cursor_y <= monitor_y + edge_px )); then
  : > "${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/restore-anchor" 2>/dev/null || true
  hyprctl dispatch 'hl.dsp.window.fullscreen({ mode = "maximized" })' >/dev/null
  exit 0
fi

# Left or right edge: the same half-screen dock as Super+Left/Right.
if (( cursor_x <= monitor_x + edge_px )); then
  exec "$HOME/.config/omarchy/window-dock" left
elif (( cursor_x >= right_edge - edge_px )); then
  exec "$HOME/.config/omarchy/window-dock" right
fi
