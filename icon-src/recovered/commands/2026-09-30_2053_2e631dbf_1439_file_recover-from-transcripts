# written to: ~/Projects/personal/omarchy-desktop/icon-src/recover-from-transcripts
#!/usr/bin/env python3
"""Recover taskbar icon work (drawings, drafts, generator scripts) from Claude
Code's session transcripts (~/.claude/projects/**/*.jsonl, subagents included).

  recover-from-transcripts [<out-dir>]      default: ./recovered next to this

Every tool call that wrote an icon body or an icon script, or ran icon-set /
icon-preview / an icon generator, is saved as a file named
<date>_<time>_<session>_<n>_<what>, and listed in <out-dir>/INDEX.md with the
icon names it mentions. Safe to run again: it rewrites <out-dir>.
"""
import json
import pathlib
import re
import shutil
import sys

HOME = pathlib.Path.home()
PROJECTS = HOME / ".claude/projects"
OUT = pathlib.Path(sys.argv[1]) if len(sys.argv) > 1 else pathlib.Path(__file__).resolve().parent / "recovered"

ICONISH_PATH = re.compile(r"(\.svgbody$|\.svg$|icons?/|icon[-_]|taskbar-icons)", re.I)
ICONISH_CMD = re.compile(r"(svgbody|icon-set|icon-preview|icon-test|taskbar-icons\.js)")
SVG_BODY = re.compile(r"<(path|circle|rect|line|polyline|polygon|ellipse)\b")
GENERATOR = re.compile(r"(math\.(cos|sin|pi|radians)|Math\.(cos|sin|PI))")
NAME_FROM_FILE = re.compile(r"([a-z0-9_-]+?)(?:[-_](?:v\d+|alt\w*|[a-z]))?\.svgbody$")


def tool_uses(path):
    session = path.stem[:8] if "subagents" not in path.parts else f"{path.parent.parent.name[:8]}-{path.stem[-6:]}"
    with path.open(errors="replace") as fh:
        for line in fh:
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            msg = rec.get("message") or {}
            if rec.get("type") != "assistant" or not isinstance(msg.get("content"), list):
                continue
            for block in msg["content"]:
                if isinstance(block, dict) and block.get("type") == "tool_use":
                    yield session, rec.get("timestamp", ""), block.get("name"), block.get("input") or {}


def classify(tool, inp):
    """-> (kind, suggested file name, content) or None"""
    if tool == "Write":
        fp = str(inp.get("file_path", ""))
        content = str(inp.get("content", ""))
        if fp.endswith("taskbar-icons.js"):
            return ("iconset", "taskbar-icons.js", content)
        if ICONISH_PATH.search(fp) and (SVG_BODY.search(content) or GENERATOR.search(content) or "icon" in fp.lower()):
            return ("file", pathlib.Path(fp).name, f"# written to: {fp}\n{content}" if not fp.endswith((".svgbody", ".svg")) else content)
        if GENERATOR.search(content) and SVG_BODY.search(content + "<path"):
            return ("generator", pathlib.Path(fp).name, f"# written to: {fp}\n{content}")
    elif tool == "Edit":
        fp = str(inp.get("file_path", ""))
        if ICONISH_PATH.search(fp) and SVG_BODY.search(str(inp.get("new_string", ""))):
            return ("edit", pathlib.Path(fp).name + ".edit",
                    f"# edit of: {fp}\n# --- old\n{inp.get('old_string', '')}\n# --- new\n{inp.get('new_string', '')}\n")
    elif tool == "Bash":
        cmd = str(inp.get("command", ""))
        if ICONISH_CMD.search(cmd) or (GENERATOR.search(cmd) and ("M12" in cmd or "<path" in cmd or "svg" in cmd)):
            # Only commands that carry drawings or generate them; skip bare lookups.
            if SVG_BODY.search(cmd) or GENERATOR.search(cmd) or "icon-set" in cmd or "cat >" in cmd or "<<" in cmd:
                return ("bash", "command.sh", cmd + "\n")
    return None


def names_in(text):
    found = set(NAME_FROM_FILE.findall(text))
    found |= set(re.findall(r"icon-set\s+([a-z0-9_-]+)\s", text))
    return sorted(n for n in found if n not in {"body", "b", "icon", "test"})


def main():
    if OUT.exists():
        shutil.rmtree(OUT)
    OUT.mkdir(parents=True)
    rows = []
    seen = set()
    for path in sorted(PROJECTS.rglob("*.jsonl")):
        for n, (session, ts, tool, inp) in enumerate(tool_uses(path)):
            got = classify(tool, inp)
            if not got:
                continue
            kind, name, content = got
            key = hash(content)
            if key in seen:
                continue
            seen.add(key)
            stamp = (ts[:16] or "0000-00-00T00:00").replace(":", "").replace("T", "_")
            fname = f"{stamp}_{session}_{n:04d}_{kind}_{name}"
            (OUT / fname).write_text(content)
            fp = str(inp.get("file_path", ""))
            icons = names_in(fp + "\n" + content[:4000])
            rows.append((stamp, session, kind, fname, fp or (content.strip().splitlines() or [""])[0][:90], icons))
    rows.sort()
    with (OUT / "INDEX.md").open("w") as idx:
        idx.write("# Recovered icon work\n\nFrom Claude Code transcripts (`recover-from-transcripts`). "
                  "Newest at the bottom. `kind`: file = a drawing/script written to disk, "
                  "iconset = a full taskbar-icons.js, edit = an edit to one, "
                  "bash = a command that drew, generated or added icons.\n\n")
        idx.write("| when | session | kind | icons | file | from |\n|---|---|---|---|---|---|\n")
        for stamp, session, kind, fname, what, icons in rows:
            what = what.replace("|", "\\|").replace("\n", " ")
            idx.write(f"| {stamp} | {session} | {kind} | {', '.join(icons)} | {fname} | {what} |\n")
    print(f"{len(rows)} items -> {OUT}")


main()
