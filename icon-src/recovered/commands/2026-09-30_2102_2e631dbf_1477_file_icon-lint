#!/usr/bin/env python3
"""Check icons against the spec (icon-src/ICON-SPEC.md; iconkit.lint).

  icon-lint                    every icon script (the ones icon-build uses)
  icon-lint <file>...          these: icon scripts (.icon.py / .py) or drafts
                               (.svgbody)
  icon-lint --user             your own icon scripts, on the maintainer's PC

Prints ✗ for errors (icon-build refuses them) and ! for warnings (worth a
look: off centre, small, an unusual stroke weight).
Exit status: 0 no errors, 1 errors, 2 usage.
"""
import pathlib
import sys

from iconkit import lint, maintainer, read_body, source_dir


def main():
    args = sys.argv[1:]
    if any(a in ("-h", "--help") for a in args):
        print(__doc__)
        sys.exit(0)
    user = "--user" in args
    files = [pathlib.Path(a) for a in args if a != "--user"]
    if not files:
        files = sorted(source_dir(user or not maintainer()).glob("*.icon.py"))
    errors = warnings = 0
    for f in files:
        name = f.name.split(".")[0]
        try:
            problems = lint(read_body(f))
        except (OSError, RuntimeError) as e:
            problems = [("error", str(e))]
        for level, msg in problems:
            print(f"{'✗' if level == 'error' else '!'} {name}: {msg}")
            errors += level == "error"
            warnings += level == "warn"
    print(f"{len(files)} icon(s): {errors} error(s), {warnings} warning(s)")
    sys.exit(1 if errors else 0)


main()
