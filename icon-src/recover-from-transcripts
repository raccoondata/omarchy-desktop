#!/usr/bin/env python3
"""Recover taskbar icon work (drawings, drafts, generator scripts) from Claude
Code's session transcripts (~/.claude/projects/**/*.jsonl, subagents included).

  recover-from-transcripts [<out-dir>]      default: ./recovered next to this

Output:
  by-icon/<name>/      every drawing of that icon, oldest first
                       (<date>_<time>_<session>_<file>): drafts, alternates,
                       and final.svgbody, the one in the current icon set
  commands/            the commands and scripts that drew, generated or added
                       icons (heredocs, generators, icon-set runs)
  INDEX.md             all of it by date, with the icon names each mentions
Safe to run again: it rewrites <out-dir>.
"""
import json
import pathlib
import re
import shutil
import sys

HOME = pathlib.Path.home()
PROJECTS = HOME / ".claude/projects"
OUT = pathlib.Path(sys.argv[1]) if len(sys.argv) > 1 else pathlib.Path(__file__).resolve().parent / "recovered"

ICONISH_PATH = re.compile(r"(\.svgbody$|\.svg$|icons?/|icon[-_]|taskbar-icons)", re.I)
ICONISH_CMD = re.compile(r"(svgbody|icon-set|icon-preview|icon-test|taskbar-icons\.js)")
SVG_BODY = re.compile(r"<(path|circle|rect|line|polyline|polygon|ellipse)\b")
GENERATOR = re.compile(r"(math\.(cos|sin|pi|radians)|Math\.(cos|sin|PI))")
HEREDOC = re.compile(r"cat\s*>\s*(\S+\.(?:svgbody|svg|txt))\s*<<\s*'?(\w+)'?\n(.*?)\n\2\s*(?:\n|$)", re.S)
DRAFT_SUFFIX = re.compile(r"([-_](v\d+|alt\w*|[a-z]|\d+|old|new|final|f\d+|draft\w*))+$")
NAME_FROM_FILE = re.compile(r"([a-z0-9_-]+?)(?:[-_](?:v\d+|alt\w*|[a-z]))?\.svgbody$")


def tool_uses(path):
    session = path.stem[:8] if "subagents" not in path.parts else f"{path.parent.parent.name[:8]}-{path.stem[-6:]}"
    with path.open(errors="replace") as fh:
        for line in fh:
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            msg = rec.get("message") or {}
            if rec.get("type") != "assistant" or not isinstance(msg.get("content"), list):
                continue
            for block in msg["content"]:
                if isinstance(block, dict) and block.get("type") == "tool_use":
                    yield session, rec.get("timestamp", ""), block.get("name"), block.get("input") or {}


def classify(tool, inp):
    """-> (kind, suggested file name, content) or None"""
    if tool == "Write":
        fp = str(inp.get("file_path", ""))
        content = str(inp.get("content", ""))
        if fp.endswith("taskbar-icons.js"):
            return ("iconset", "taskbar-icons.js", content)
        if ICONISH_PATH.search(fp) and (SVG_BODY.search(content) or GENERATOR.search(content) or "icon" in fp.lower()):
            return ("file", pathlib.Path(fp).name, f"# written to: {fp}\n{content}" if not fp.endswith((".svgbody", ".svg")) else content)
        if GENERATOR.search(content) and SVG_BODY.search(content + "<path"):
            return ("generator", pathlib.Path(fp).name, f"# written to: {fp}\n{content}")
    elif tool == "Edit":
        fp = str(inp.get("file_path", ""))
        if ICONISH_PATH.search(fp) and SVG_BODY.search(str(inp.get("new_string", ""))):
            return ("edit", pathlib.Path(fp).name + ".edit",
                    f"# edit of: {fp}\n# --- old\n{inp.get('old_string', '')}\n# --- new\n{inp.get('new_string', '')}\n")
    elif tool == "Bash":
        cmd = str(inp.get("command", ""))
        if ICONISH_CMD.search(cmd) or (GENERATOR.search(cmd) and ("M12" in cmd or "<path" in cmd or "svg" in cmd)):
            # Only commands that carry drawings, generate them, preview them or
            # put them in the set; not lookups that merely mention the file.
            if SVG_BODY.search(cmd) or GENERATOR.search(cmd) or re.search(r"(icon-set|icon-preview)\s+\S", cmd) \
                    or re.search(r"taskbar-icons\.js.*(write_text|json\.dumps)", cmd, re.S):
                return ("generator" if GENERATOR.search(cmd) else "bash", "command.sh", cmd + "\n")
    return None


def names_in(text, known=()):
    found = set(NAME_FROM_FILE.findall(text))
    found |= set(re.findall(r"icon-set\s+([a-z0-9_-]+)\s", text))
    # Known icon names used as a key or a file name: "claude", 'claude', claude.txt
    for n in known:
        if len(n) > 1 and re.search(r"[\"'/\s]" + re.escape(n) + r"(\.(txt|svg|svgbody|py)|[\"'])", text):
            found.add(n)
    return sorted(n for n in found if n not in {"body", "b", "icon", "test", "app"})


def echo_drawings(cmd):
    """(file, body) for lines like  echo "$P"'<path .../>' > writer.svgbody,
    with shell variables (NAME='...' assignments earlier in the command)
    expanded by hand; nothing is run."""
    import shlex
    env, out = {}, []
    for line in re.split(r"\n|;\s*|&&", cmd):
        line = line.strip()
        m = re.match(r"^([A-Za-z_]\w*)=(.+)$", line)
        if m:
            try:
                env[m.group(1)] = " ".join(shlex.split(m.group(2)))
            except ValueError:
                pass
            continue
        m = re.match(r"^(?:echo|printf '%s\\n')\s+(.+?)\s*>\s*(\S+\.(?:svgbody|svg|txt))$", line)
        if m:
            try:
                parts = shlex.split(m.group(1))
            except ValueError:
                continue
            text = " ".join(parts)
            text = re.sub(r"\$\{?([A-Za-z_]\w*)\}?", lambda v: env.get(v.group(1), v.group(0)), text)
            out.append((m.group(2), text))
    return out


def icon_of(filename, known):
    stem = pathlib.Path(filename).name.split(".")[0].lower()
    if stem in known:
        return stem
    stem = re.sub(r"^(i|icon|draft)[-_]", "", stem)
    bases = [stem, DRAFT_SUFFIX.sub("", stem), re.sub(r"\d+$", "", stem), re.sub(r"[a-z]$", "", stem)]
    for base in bases:
        if base in known:
            return base
    # Shorthand for one known icon: a prefix (rust -> rustdesk) or its
    # letters in order from the first (tg -> telegram, ytm -> youtubemusic).
    def abbrev(a, n):
        it = iter(n)
        return a[0] == n[0] and all(ch in it for ch in a)
    for base in bases[1:]:
        if len(base) < 2:
            continue
        hits = [n for n in known if n.startswith(base)] or [n for n in known if abbrev(base, n)]
        if len(hits) == 1:
            return hits[0]
    return "_other"


def final_icons():
    js = HOME / ".config/omarchy/bar/modules/taskbar-icons.js"
    out = {}
    for line in js.read_text().split("\n"):
        m = re.match(r'^  ("[a-z0-9_-]+"): (".*"),?$', line)
        if m:
            out[json.loads(m.group(1))] = json.loads(m.group(2))
    try:
        out.update(json.loads((HOME / ".config/omarchy/taskbar-icons.json").read_text()).get("icons", {}))
    except (OSError, ValueError):
        pass
    return out


def main():
    if OUT.exists():
        shutil.rmtree(OUT)
    (OUT / "commands").mkdir(parents=True)
    (OUT / "by-icon").mkdir()
    finals = final_icons()
    known = set(finals)
    rows = []
    seen = set()
    pending = {}

    def save_drawing(stamp, session, filename, body, src):
        name = icon_of(filename, known)
        d = OUT / "by-icon" / name
        d.mkdir(exist_ok=True)
        key = (name, hash(body.strip()))
        if key in seen:
            return
        seen.add(key)
        (d / f"{stamp}_{session}_{pathlib.Path(filename).name}").write_text(body.strip() + "\n")
        rows.append((stamp, session, "drawing", f"by-icon/{name}/{stamp}_{session}_{pathlib.Path(filename).name}", src, [name]))

    for path in sorted(PROJECTS.rglob("*.jsonl")):
        for n, (session, ts, tool, inp) in enumerate(tool_uses(path)):
            got = classify(tool, inp)
            if not got:
                continue
            kind, name, content = got
            stamp = (ts[:16] or "0000-00-00T00:00").replace(":", "").replace("T", "_")
            fp = str(inp.get("file_path", ""))
            # Single drawings: into by-icon/.
            if kind == "file" and fp.endswith((".svgbody", ".svg")) and SVG_BODY.search(content):
                save_drawing(stamp, session, fp, content, fp)
                continue
            if kind == "iconset":
                continue  # the full set: its icons are in final.svgbody
            # Heredocs inside commands: each drawing into by-icon/ too.
            for hfile, _, body in HEREDOC.findall(content):
                if SVG_BODY.search(body):
                    save_drawing(stamp, session, hfile, body, f"heredoc in a {tool} command")
            for efile, body in echo_drawings(content):
                if SVG_BODY.search(body) and "$" not in body:
                    save_drawing(stamp, session, efile, body, f"echo in a {tool} command")
            key = hash(content)
            if key in seen:
                continue
            seen.add(key)
            fname = f"commands/{stamp}_{session}_{n:04d}_{kind}_{name}"
            (OUT / fname).write_text(content)
            icons = names_in(fp + "\n" + content, known)
            # A generator in a temp dir feeds whatever the next command
            # installs from that dir (e.g. /tmp/.../cl/D.txt -> "claude").
            dirs = set(re.findall(r"(/tmp/[\w./-]+?)/(?:[\w.-]+\.(?:txt|py|svg|svgbody))?(?=[\s'\"]|$)", content))
            dirs |= set(re.findall(r"(?:cd|mkdir -p)\s+(/tmp/[\w./-]+)", content))
            for dd in dirs:
                pending.setdefault(dd, []).append(fname)
            if icons and kind != "file":
                for dd in [k for k in list(pending) if any(x == k or x.startswith(k + "/") for x in dirs)]:
                    if dd.count("/") < 3:
                        continue  # too broad (/tmp/claude-1000)
                    for earlier in pending.pop(dd, []):
                        if earlier != fname:
                            for icon in icons:
                                if icon in known and len(icons) <= 4:
                                    d = OUT / "by-icon" / icon
                                    d.mkdir(exist_ok=True)
                                    link = d / pathlib.Path(earlier).name
                                    if not link.exists():
                                        link.symlink_to(pathlib.Path("../..") / earlier)
            # A command about a few icons: linked from their folders too.
            if icons and (len(icons) <= 4 or kind == "generator") and kind != "file":
                for icon in icons:
                    d = OUT / "by-icon" / icon
                    if icon in known:
                        d.mkdir(exist_ok=True)
                        link = d / pathlib.Path(fname).name
                        if not link.exists():
                            link.symlink_to(pathlib.Path("../..") / fname)
            rows.append((stamp, session, kind, fname, fp or (content.strip().splitlines() or [""])[0][:90], icons))
    for name, body in finals.items():
        d = OUT / "by-icon" / name
        d.mkdir(exist_ok=True)
        (d / "final.svgbody").write_text(body + "\n")
        script = pathlib.Path(__file__).resolve().parent / "icons" / f"{name}.icon.py"
        if script.exists() and not (d / "script.icon.py").exists():
            (d / "script.icon.py").symlink_to(pathlib.Path("../../..") / "icons" / script.name)
    rows.sort()
    with (OUT / "INDEX.md").open("w") as idx:
        idx.write("# Recovered icon work\n\nFrom Claude Code transcripts (`recover-from-transcripts`). "
                  "Newest at the bottom. `kind`: drawing = one icon body (draft or final), "
                  "file = another icon file or script, edit = an edit to one, generator = a script "
                  "that computed a drawing, bash = a command that drew, generated or added icons.\n\n")
        idx.write("| when | session | kind | icons | file | from |\n|---|---|---|---|---|---|\n")
        for stamp, session, kind, fname, what, icons in rows:
            what = what.replace("|", "\\|").replace("\n", " ")
            idx.write(f"| {stamp} | {session} | {kind} | {', '.join(icons)} | {fname} | {what} |\n")
    print(f"{len(rows)} items -> {OUT}")


main()
